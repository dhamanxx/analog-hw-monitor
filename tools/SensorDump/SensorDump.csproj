<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sensordump</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately pinned to the SAME version AnalogHwMonitor.Core uses, so this
         tool reports exactly what the application sees. To test whether a newer
         library reads a sensor the current one misses, bump this number here only
         and publish a second copy under a different name — do not change the
         application's version until the comparison proves it helps. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
